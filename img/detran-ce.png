<div class="pgbusca-modal-overlay" id="pgbusca-modal-overlay" aria-hidden="true" style="display:none;">
    <div class="pgbusca-modal" role="dialog" aria-labelledby="pgbusca-modal-title" aria-modal="true">
        <button class="pgbusca-modal-close" id="pgbusca-modal-close" aria-label="Fechar modal">
            <span class="material-symbols-outlined">close</span>
        </button>

        <div class="pgbusca-modal-header">
            <h2 id="pgbusca-modal-title">O que você não encontrou?</h2>
            <p class="pgbusca-modal-subtitle">Descreva no campo a seguir o que você procurou e não encontrou no nosso site.</p>
        </div>

        <div class="pgbusca-modal-body">
            <form id="pgbusca-feedback-form" class="pgbusca-feedback-form">
                <div class="pgbusca-form-group">
                    <textarea 
                        id="pgbusca-feedback-textarea"
                        name="feedback"
                        class="pgbusca-feedback-textarea"
                        placeholder="Digite sua descrição"
                        maxlength="500"
                        required
                    ></textarea>
                    <div class="pgbusca-textarea-counter">
                        <span id="pgbusca-char-count">0</span>/500
                    </div>
                </div>

                <div class="pgbusca-form-row">
                    <div class="pgbusca-form-group">
                        <label class="pgbusca-form-label" for="pgbusca-feedback-name">Nome</label>
                        <input
                            type="text"
                            id="pgbusca-feedback-name"
                            name="name"
                            class="pgbusca-feedback-input"
                            placeholder="Digite seu nome"
                            maxlength="120"
                        >
                    </div>

                    <div class="pgbusca-form-group">
                        <label class="pgbusca-form-label" for="pgbusca-feedback-email">E-mail</label>
                        <input
                            type="email"
                            id="pgbusca-feedback-email"
                            name="email"
                            class="pgbusca-feedback-input"
                            placeholder="Digite seu e-mail"
                            maxlength="160"
                        >
                    </div>
                </div>

                <div class="pgbusca-form-actions">
                    <button type="submit" class="pgbusca-btn-enviar" aria-label="Enviar feedback">
                        Enviar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Sucesso -->
<div class="pgbusca-modal-overlay" id="pgbusca-success-overlay" aria-hidden="true" style="display:none;">
    <div class="pgbusca-modal pgbusca-modal-success" role="dialog" aria-labelledby="pgbusca-success-title" aria-modal="true">
        <div class="pgbusca-modal-header pgbusca-modal-header-success">
            <button class="pgbusca-modal-close" id="pgbusca-success-close" aria-label="Fechar modal">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="pgbusca-modal-body pgbusca-modal-body-success">
            <div class="pgbusca-success-icon">
                <span class="material-symbols-outlined">check_circle</span>
            </div>

            <h2 id="pgbusca-success-title" class="pgbusca-success-title">Recebemos sua mensagem!</h2>

            <p class="pgbusca-success-text">Sua sugestão nos ajuda a tornar o ce.gov.br ainda melhor, e vamos usá-la para aprimorar nossos serviços.</p>

            <button type="button" class="pgbusca-btn-entendi" id="pgbusca-btn-entendi" aria-label="Fechar modal de sucesso">
                Entendi
            </button>
        </div>
    </div>
</div>

