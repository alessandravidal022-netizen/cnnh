    <div class="modal-card" role="document">
        <button class="modal-close" data-modal-close aria-label="Fechar modal">×</button>
        <div id="error-suggestions-modal">
            <span class="material-symbols-outlined" aria-hidden="true">search_off</span>
            <div class="error-title" id="error-title">Não conseguimos mostrar a busca agora.</div>
            <div class="error-sub">Por favor, tente novamente mais tarde.</div>
        </div>
    </div>
</div>

