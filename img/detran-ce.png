        <script>
        (function () {
            if (window.cegovbrActivateDeferredInjects) {
                return;
            }

            function getConsent() {
                try {
                    return window.localStorage.getItem('cegovbr_cookie_consent');
                } catch (e) {
                    return null;
                }
            }

            function activateTemplate(template) {
                if (!template || template.dataset.applied === '1') {
                    return;
                }

                var target = template.dataset.cegovbrDeferredInject === 'body' ? document.body : document.head;
                if (!target) {
                    return;
                }

                var fragment = document.createRange().createContextualFragment(template.innerHTML);
                fragment.querySelectorAll('script').forEach(function (oldScript) {
                    var newScript = document.createElement('script');
                    Array.from(oldScript.attributes).forEach(function (attr) {
                        newScript.setAttribute(attr.name, attr.value);
                    });
                    newScript.text = oldScript.text || oldScript.textContent || '';
                    oldScript.parentNode.replaceChild(newScript, oldScript);
                });

                target.appendChild(fragment);
                template.dataset.applied = '1';
            }

            window.cegovbrActivateDeferredInjects = function () {
                if (getConsent() !== 'accepted') {
                    return;
                }

                document.querySelectorAll('template[data-cegovbr-deferred-inject]').forEach(activateTemplate);
            };

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', window.cegovbrActivateDeferredInjects);
            } else {
                window.cegovbrActivateDeferredInjects();
            }

            window.addEventListener('cegovbr:cookie-consent', function (event) {
                if (event.detail && event.detail.value === 'accepted') {
                    window.cegovbrActivateDeferredInjects();
                }
            });
        })();
    </script>
</head>

