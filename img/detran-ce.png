    <meta name="referrer" content="strict-origin-when-cross-origin">
    <script>
        document.documentElement.classList.add('cegovbr-icons-loading');

        // Força HTTPS em ambiente de desenvolvimento se não estiver usando
        if (location.protocol === 'http:' && location.hostname.endsWith('.test')) {
            location.replace(window.location.href.replace('http:', 'https:'));
        }
        // Silencia erros de extensões que tentam acessar o body antes do tempo
        window.addEventListener('error', function(e) {
            if (e.message.indexOf('childNodes') > -1 && !document.body) {
                e.preventDefault();
                e.stopPropagation();
            }
        }, true);
    </script>
