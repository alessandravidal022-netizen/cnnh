    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var logosFooter = document.querySelectorAll('img.logo-footer');
            var brasaoUrl = "https:\/\/www.ce.gov.br\/detran\/wp-content\/themes\/cegovbr\/assets\/images\/brasao%201.png";
            var brasaoAlt = "Bras\u00e3o do Governo do Estado do Cear\u00e1";

            logosFooter.forEach(function (logo) {
                logo.setAttribute('src', brasaoUrl);
                logo.setAttribute('alt', brasaoAlt);
                logo.removeAttribute('srcset');
                logo.removeAttribute('sizes');
            });
        });
    </script>
    

