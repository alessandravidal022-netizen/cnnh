            font-weight: 400;
            font-display: block;
            src: url('https://www.ce.gov.br/detran/wp-content/themes/cegovbr/assets/fonts/material-symbols/MaterialSymbolsOutlined-Regular.ttf') format('truetype');
        }

        .material-icons,
