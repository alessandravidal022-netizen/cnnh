    <style>
        /* Estilos críticos do Bootstrap para estrutura base */
        .d-flex {
            display: flex;
        }

        .flex-column {
            flex-direction: column;
        }

        .flex-column-reverse {
            flex-direction: column-reverse;
        }

        .flex-row {
            flex-direction: row;
        }

        .flex-grow-1 {
            flex-grow: 1;
        }

        .bg-primary {
            background-color: #0d6b4a;
        }

        .min-vh-100 {
            min-height: 100vh;
        }

        .position-relative {
            position: relative;
        }

        .position-sticky {
            position: sticky;
        }

        .position-absolute {
            position: absolute;
        }

        .top-0 {
            top: 0;
        }

        .d-none {
            display: none;
        }

        .gap-5 {
            gap: 3rem;
        }

        .gap-3 {
            gap: 1rem;
        }

        .px-0 {
            padding-left: 0;
            padding-right: 0;
        }

        .h-75 {
            height: 75%;
