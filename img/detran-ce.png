<style id="cegovbr-mural-materiais-card-mer-style-inline-css">
.ckc-card-mer-front{margin:1.25rem 0;max-width:100%}.ckc-card-mer-container{background:#fefefe;border:.0625rem solid #c5c5c5;border-radius:1rem;display:flex;flex-direction:column;gap:.25rem;padding:1.5rem}.ckc-card-mer-icon{align-items:center;display:flex;justify-content:center;margin-bottom:.75rem}.ckc-card-mer-icon .material-symbols-outlined{color:#1b7727;font-size:3rem;font-weight:300}.ckc-card-mer-date{color:#3c4650;font-size:.875rem;font-weight:300}.ckc-card-mer-date,.ckc-card-mer-title{font-family:Kanit,sans-serif;letter-spacing:0;line-height:100%;margin:0;padding:.125rem}.ckc-card-mer-title{color:#465564;font-size:1.25rem;font-weight:400;vertical-align:middle}.ckc-card-mer-folders{display:flex;flex-direction:column;gap:0;margin-top:.5rem}.ckc-mer-folder-item{display:flex;flex-direction:column;gap:.5rem}.ckc-mer-folder-toggle,.ckc-mer-subfolder-toggle{align-items:center;background:none;border:none;color:#239832;cursor:pointer;display:flex;font-family:Kanit,sans-serif;font-size:.875rem;font-weight:600;gap:0;letter-spacing:.0312rem;line-height:100%;padding:0;text-align:left;text-transform:uppercase;transition:all .2s ease;-webkit-user-select:none;-moz-user-select:none;user-select:none}.ckc-mer-folder-toggle:hover,.ckc-mer-subfolder-toggle:hover{opacity:.8}.ckc-mer-folder-toggle:focus,.ckc-mer-subfolder-toggle:focus{outline:none}.ckc-mer-folder-toggle .ckc-mer-toggle-icon,.ckc-mer-subfolder-toggle .ckc-mer-toggle-icon{align-items:center;color:#239832;display:inline-flex;flex-shrink:0;font-size:1.5rem;height:1.5rem;justify-content:center;transition:transform .2s ease;width:1.5rem}.ckc-mer-folder-toggle .ckc-mer-folder-icon,.ckc-mer-subfolder-toggle .ckc-mer-folder-icon{align-items:center;color:#239832;display:inline-flex;flex-shrink:0;font-size:1.25rem;font-variation-settings:"FILL" 1;height:1.25rem;justify-content:center;margin-right:.25rem;width:1.25rem}.ckc-mer-folder-toggle .ckc-mer-folder-name,.ckc-mer-folder-toggle .ckc-mer-subfolder-name,.ckc-mer-subfolder-toggle .ckc-mer-folder-name,.ckc-mer-subfolder-toggle .ckc-mer-subfolder-name{color:#239832;flex:1;font-family:Kanit,sans-serif;font-size:.875rem;font-weight:600;letter-spacing:.0312rem;line-height:100%;margin:0;padding:0;text-transform:uppercase}.ckc-mer-folder-content,.ckc-mer-subfolder-content{display:none;flex-direction:column;gap:.75rem;margin-top:0;max-height:0;overflow:hidden;padding-left:1.25rem;transition:max-height .3s ease}.ckc-mer-folder-content.ckc-mer-open,.ckc-mer-subfolder-content.ckc-mer-open{display:flex;max-height:312.5rem}.ckc-mer-subfolder-item{display:flex;flex-direction:column;gap:.5rem}.ckc-mer-file-item a{align-items:center;background:none;border:none;color:#239832;display:flex;font-family:Kanit,sans-serif;font-size:.875rem;font-weight:500;gap:.25rem;letter-spacing:0;line-height:100%;margin-left:1.5625rem;padding:0;text-decoration:none;transition:all .2s ease}.ckc-mer-file-item a:hover{opacity:.8;text-decoration:underline}.ckc-mer-file-item a .ckc-mer-file-icon{align-items:center;color:#239832;display:inline-flex;flex-shrink:0;font-size:1rem;height:1rem;justify-content:center;width:1rem}.ckc-mer-file-item a .ckc-mer-file-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}@media(max-width:48rem){.ckc-card-mer-container{border-radius:.75rem;padding:1rem}.ckc-card-mer-date{font-size:.8125rem}.ckc-card-mer-title{font-size:1.125rem}.ckc-mer-file-item a,.ckc-mer-folder-name,.ckc-mer-subfolder-name{font-size:.8125rem}.ckc-mer-folder-content,.ckc-mer-subfolder-content{padding-left:1rem}}@media(max-width:30rem){.ckc-card-mer-container{border-radius:.625rem;padding:.75rem}.ckc-card-mer-date{font-size:.75rem}.ckc-card-mer-title{font-size:1rem}.ckc-mer-file-item a,.ckc-mer-folder-name,.ckc-mer-subfolder-name{font-size:.75rem}.ckc-mer-folder-content,.ckc-mer-subfolder-content{gap:.125rem;padding-left:.75rem}}body.body-contraste .ckc-card-mer-container{background-color:#000!important;border-color:#fff!important}body.body-contraste .ckc-card-mer-date,body.body-contraste .ckc-card-mer-icon .material-symbols-outlined,body.body-contraste .ckc-card-mer-title,body.body-contraste .ckc-mer-folder-toggle,body.body-contraste .ckc-mer-folder-toggle .ckc-mer-folder-icon,body.body-contraste .ckc-mer-folder-toggle .ckc-mer-folder-name,body.body-contraste .ckc-mer-folder-toggle .ckc-mer-subfolder-name,body.body-contraste .ckc-mer-folder-toggle .ckc-mer-toggle-icon,body.body-contraste .ckc-mer-subfolder-toggle,body.body-contraste .ckc-mer-subfolder-toggle .ckc-mer-folder-icon,body.body-contraste .ckc-mer-subfolder-toggle .ckc-mer-folder-name,body.body-contraste .ckc-mer-subfolder-toggle .ckc-mer-subfolder-name,body.body-contraste .ckc-mer-subfolder-toggle .ckc-mer-toggle-icon{color:#fff!important}body.body-contraste .ckc-mer-folder-toggle:hover,body.body-contraste .ckc-mer-subfolder-toggle:hover{opacity:1}body.body-contraste .ckc-mer-folder-toggle:hover .ckc-mer-folder-name,body.body-contraste .ckc-mer-folder-toggle:hover .ckc-mer-subfolder-name,body.body-contraste .ckc-mer-subfolder-toggle:hover .ckc-mer-folder-name,body.body-contraste .ckc-mer-subfolder-toggle:hover .ckc-mer-subfolder-name{text-decoration:underline}body.body-contraste .ckc-mer-file-item a{color:#fff!important;text-decoration:underline!important}body.body-contraste .ckc-mer-file-item a .ckc-mer-file-icon{color:#fff!important}body.body-contraste .ckc-mer-file-item a:hover{color:#fff!important;text-decoration:underline}body.body-contraste .ckc-mer-file-item a:hover .ckc-mer-file-icon{color:#fff!important}

