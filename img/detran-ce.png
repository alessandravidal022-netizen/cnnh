        <script>
            document.addEventListener("DOMContentLoaded", function() {
                const toggleBtn = document.getElementById("cc-toggle-aside");
                const aside = document.querySelector("aside");
                let tooltipInstances = [];

                // Função para definir cookie
                function setCookie(name, value, days) {
                    const date = new Date();
                    date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                    document.cookie = `${name}=${value};expires=${date.toUTCString()};path=/`;
                }

                // Função para obter cookie
                function getCookie(name) {
                    const match = document.cookie.match(new RegExp("(^| )" + name + "=([^;]+)"));
                    return match ? match[2] : null;
                }

                // Função para ativar tooltips
                function enableTooltips() {
                    const triggersAside = document.querySelectorAll('aside [data-bs-toggle="tooltip"]');
                    tooltipInstances = [...triggersAside].map(el => new bootstrap.Tooltip(el));
                }

                // Função para desativar tooltips
                function disableTooltips() {
                    tooltipInstances.forEach(instance => instance.dispose());
                    tooltipInstances = [];
                }

                // Estado inicial: sempre aberto ao carregar a página
                aside.classList.remove("toggled");
                disableTooltips();

                // Ao clicar, alterna o estado e salva no cookie
                toggleBtn.addEventListener("click", function() {
                    aside.classList.toggle("toggled");

                    if (aside.classList.contains("toggled")) {
                        enableTooltips();
                        setCookie("asideState", "toggled", 30);
                    } else {
                        disableTooltips();
                        setCookie("asideState", "not-toggled", 30);
                    }
                });

                // Posiciona submenus com position:fixed quando o aside está fechado (toggled)
                document.addEventListener('show.bs.collapse', function(e) {
                    var submenu = e.target;
                    if (!submenu.classList.contains('cc-mais-sites')) return;

                    if (aside.classList.contains('toggled')) {
                        // aside fechado: abre à direita via position:fixed (CSS) — ajusta top
                        var trigger = document.querySelector('[data-bs-target="#' + CSS.escape(submenu.id) + '"]');
                        if (!trigger) return;
                        var rect = trigger.getBoundingClientRect();
                        submenu.style.top = rect.top + 'px';
                    } else if (submenu.id === 'cc-gtranslate-target') {
                        // aside aberto: acompanha a expansão do Bootstrap quadro a quadro via rAF
                        // e rola o container para manter o fundo do submenu visível em tempo real
                        var scrollContainer = aside.querySelector('.position-sticky.h-75');
                        if (!scrollContainer) return;
                        scrollContainer.dataset.savedScroll = scrollContainer.scrollTop;
                        var expanded = false;
                        submenu.addEventListener('shown.bs.collapse', function onShown() {
                            submenu.removeEventListener('shown.bs.collapse', onShown);
                            expanded = true;
                        });
                        (function trackExpand() {
                            if (expanded) return;
                            var cBottom = scrollContainer.getBoundingClientRect().bottom;
                            var sBottom = submenu.getBoundingClientRect().bottom;
                            if (sBottom > cBottom) {
                                scrollContainer.scrollTop += sBottom - cBottom;
                            }
                            requestAnimationFrame(trackExpand);
                        })();
                    }
                });

                // Limpa estilos inline ao fechar e restaura posição de scroll do gtranslate
                document.addEventListener('hide.bs.collapse', function(e) {
                    if (!e.target.classList.contains('cc-mais-sites')) return;
                    e.target.style.top = '';
                    if (!aside.classList.contains('toggled') && e.target.id === 'cc-gtranslate-target') {
                        var scrollContainer = aside.querySelector('.position-sticky.h-75');
                        if (scrollContainer && scrollContainer.dataset.savedScroll !== undefined) {
                            scrollContainer.scrollTo({ top: parseInt(scrollContainer.dataset.savedScroll, 10), behavior: 'smooth' });
                            delete scrollContainer.dataset.savedScroll;
                        }
                    }
                });
            });
        </script>

        <!-- gtranslate swapflags -->
                <script>
            document.addEventListener("DOMContentLoaded", function() {
                var FLAG_BASE = "https://www.ce.gov.br/detran/wp-content/themes/cegovbr/images/flags";

                // Mapa para sincronizar o seu botão/header
                var uiMap = {
                    "pt": {
                        label: "PT-BR",
                        flag: FLAG_BASE + "/pt-br.svg",
                        name: "Português"
                    },
                    "pt-br": {
                        label: "PT-BR",
                        flag: FLAG_BASE + "/pt-br.svg",
                        name: "Português"
                    },
                    "en": {
                        label: "EN",
                        flag: FLAG_BASE + "/en.svg",
                        name: "Inglês"
                    },
                    "en-us": {
                        label: "EN",
                        flag: FLAG_BASE + "/en.svg",
                        name: "Inglês"
                    },
                    "es": {
                        label: "ES",
                        flag: FLAG_BASE + "/es.svg",
                        name: "Espanhol"
                    }
                };

                // Mapa para substituir as flags dentro do shortcode
                var replaceFlagMap = {
                    "pt": FLAG_BASE + "/pt-br.svg",
                    "pt-br": FLAG_BASE + "/pt-br.svg",
                    "en": FLAG_BASE + "/en.svg",
                    "en-us": FLAG_BASE + "/en.svg",
                    "es": FLAG_BASE + "/es.svg"
                };

                // Mapa para trocar os labels dos anchors do shortcode (PT -> PT-BR)
                var replaceLabelMap = {
                    "pt": "PT-BR",
                    "pt-br": "PT-BR",
                    "en": "EN",
                    "en-us": "EN",
                    "es": "ES"
                };

                function norm(code) {
                    return (code || "").toLowerCase();
                }

                function normalizeGTranslateMarkup(ctx) {
                    var scope = ctx || document;
                    var wrappers = scope.querySelectorAll(".gtranslate_wrapper");

                    wrappers.forEach(function(wrapper) {
                        var firstByLang = new Map();
                        var anchors = Array.from(wrapper.querySelectorAll("a.glink[data-gt-lang]"));

                        anchors.forEach(function(anchor) {
                            var lang = norm(anchor.getAttribute("data-gt-lang"));
                            if (!lang) return;

                            if (!firstByLang.has(lang)) {
                                firstByLang.set(lang, anchor);
                                return;
                            }

                            var primary = firstByLang.get(lang);
                            if (!primary || primary === anchor) return;

                            if (!primary.querySelector("img")) {
                                var imgFromDuplicate = anchor.querySelector("img");
                                if (imgFromDuplicate) {
                                    primary.insertBefore(imgFromDuplicate.cloneNode(true), primary.firstChild);
                                }
                            }

                            if (!primary.querySelector("span")) {
                                var spanFromDuplicate = anchor.querySelector("span");
                                if (spanFromDuplicate) {
                                    primary.appendChild(spanFromDuplicate.cloneNode(true));
                                }
                            }

                            var hasPrimaryText = (primary.textContent || "").trim().length > 0;
                            var duplicateText = (anchor.textContent || "").trim();
                            if (!hasPrimaryText && duplicateText) {
                                primary.appendChild(document.createTextNode(" " + duplicateText));
                            }

                            anchor.remove();
                        });
                    });

                    var duplicateTranslateIds = document.querySelectorAll("#google_translate_element2");
                    duplicateTranslateIds.forEach(function(el, index) {
                        if (index > 0) {
                            el.id = "google_translate_element2_" + index;
                        }
                    });
                }

                // Atualiza o tooltip do botão (Bootstrap 5)
                function updateTooltipTitle(newTitle) {
                    var tipEl = document.querySelector('#cc-gtranslate [data-bs-toggle="tooltip"]');
                    if (!tipEl) return;
                    tipEl.setAttribute('data-bs-title', newTitle);
                    tipEl.setAttribute('title', newTitle);
                    if (typeof bootstrap !== 'undefined' && bootstrap.Tooltip) {
                        var instance = bootstrap.Tooltip.getInstance(tipEl);
                        if (instance && typeof instance.setContent === 'function') {
                            instance.setContent({
                                '.tooltip-inner': newTitle
                            });
                        } else {
                            if (instance) instance.dispose();
                            new bootstrap.Tooltip(tipEl);
                        }
                    }
                }

                // Sincroniza UI do botão/header
                function setUI(langCode) {
                    var info = uiMap[norm(langCode)];
                    if (!info) return;
                    var img = document.getElementById("cc-lang-flag");
                    var label = document.getElementById("cc-lang-label");
                    var header = document.getElementById("cc-lang-header");
                    if (img) {
                        img.src = info.flag;
                        img.alt = "Idioma " + info.label;
                    }
                    if (label) {
                        label.textContent = info.label;
                    }
                    var toggle = document.getElementById("cc-gtranslate-toggle");
                    if (toggle) {
                        toggle.removeAttribute("aria-label");
                        toggle.setAttribute("title", "Alterar idioma (atual: " + info.name + ")");
                    }
                    if (header) {
                        header.textContent = info.label;
                    }
                    updateTooltipTitle(info.label);
                }

                // Substitui flags e labels dentro do shortcode
                function swapFlagsAndLabels(ctx) {
                    normalizeGTranslateMarkup(ctx);
                    var anchors = (ctx || document).querySelectorAll(".gtranslate_wrapper a.glink[data-gt-lang]");
                    anchors.forEach(function(a) {
                        var code = norm(a.getAttribute("data-gt-lang"));
                        var img = a.querySelector("img");
                        var txt = a.querySelector("span");

                        var newFlag = replaceFlagMap[code];
                        var newLabel = replaceLabelMap[code];

                        if (code) {
                            a.setAttribute("href", "#googtrans-" + code);
                        }
                        if (newLabel) {
                            a.setAttribute("aria-label", "Selecionar idioma " + newLabel);
                        }

                        if (img && newFlag) {
                            img.src = newFlag;
                            img.removeAttribute("srcset");
                            img.loading = "eager";
                            img.width = 24;
                            img.height = 16;
                            img.alt = "";
                            img.setAttribute("aria-hidden", "true");
                        }
                        if (txt && newLabel) {
                            txt.textContent = newLabel;
                        }
                    });
                }

                // 1) Troca flags/labels já renderizadas
                swapFlagsAndLabels();

                // 2) Observa mudanças no wrapper (GTranslate pode re-renderizar)
                var mo = new MutationObserver(function(muts) {
                    var doSwap = false,
                        gtLangChanged = false,
                        currentLang = null;
                    muts.forEach(function(m) {
                        if (m.type === "childList" && (m.addedNodes && m.addedNodes.length)) {
                            for (var i = 0; i < m.addedNodes.length; i++) {
                                var n = m.addedNodes[i];
                                if (n.nodeType === 1 && (n.matches?.(".gtranslate_wrapper") || n.querySelector?.(".gtranslate_wrapper"))) {
                                    doSwap = true;
                                    break;
                                }
                            }
                        }
                        if (m.type === "attributes" && m.attributeName === "class" && m.target.matches?.(".gtranslate_wrapper a.glink[data-gt-lang]")) {
                            if (m.target.classList.contains("gt-current-lang")) {
                                gtLangChanged = true;
                                currentLang = m.target.getAttribute("data-gt-lang");
                            }
                        }
                    });
                    if (doSwap) swapFlagsAndLabels();
                    if (gtLangChanged && currentLang) setUI(currentLang);
                });
                mo.observe(document.body, {
                    childList: true,
                    subtree: true,
                    attributes: true,
                    attributeFilter: ["class"]
                });

                // 3) Clique nos itens do shortcode: atualiza UI e fecha o collapse
                document.addEventListener("click", function(e) {
                    var a = e.target.closest(".gtranslate_wrapper a.glink[data-gt-lang]");
                    if (!a) return;
                    var lang = a.getAttribute("data-gt-lang");
                    // pequeno delay para o plugin marcar gt-current-lang e (se necessário) re-renderizar
                    setTimeout(function() {
                        setUI(lang);
                        try {
                            var el = document.getElementById("cc-gtranslate-target");
                            if (el && typeof bootstrap !== "undefined" && bootstrap.Collapse) {
                                var c = bootstrap.Collapse.getOrCreateInstance(el);
                                c.hide();
                            }
                        } catch (_) {}
                    }, 100);
                });

                // 4) Estado inicial: pega o que o GTranslate marcou como atual
                var current = document.querySelector(".gtranslate_wrapper a.glink.gt-current-lang[data-gt-lang]");
                if (current) {
                    setUI(current.getAttribute("data-gt-lang"));
                } else {
                    setUI("pt");
                }

                // Garante que todos os ícones de material não sejam traduzidos
                document.querySelectorAll(".material-icons, .material-symbols-outlined").forEach(function(el) {
                    el.classList.add("notranslate");
                });
            });
        </script>

        <!-- Mobile GTranslate -->
        <script>
            document.addEventListener("DOMContentLoaded", function() {
                var FLAG_BASE = "https://www.ce.gov.br/detran/wp-content/themes/cegovbr/images/flags";

                var uiMap = {
                    "pt": { label: "PT-BR", flag: FLAG_BASE + "/pt-br.svg", name: "Português" },
                    "pt-br": { label: "PT-BR", flag: FLAG_BASE + "/pt-br.svg", name: "Português" },
                    "en": { label: "EN", flag: FLAG_BASE + "/en.svg", name: "Inglês" },
                    "en-us": { label: "EN", flag: FLAG_BASE + "/en.svg", name: "Inglês" },
                    "es": { label: "ES", flag: FLAG_BASE + "/es.svg", name: "Espanhol" }
                };

                var replaceFlagMap = {
                    "pt": FLAG_BASE + "/pt-br.svg",
                    "pt-br": FLAG_BASE + "/pt-br.svg",
                    "en": FLAG_BASE + "/en.svg",
                    "en-us": FLAG_BASE + "/en.svg",
                    "es": FLAG_BASE + "/es.svg"
                };

                var replaceLabelMap = {
                    "pt": "PT-BR",
                    "pt-br": "PT-BR",
                    "en": "EN",
                    "en-us": "EN",
                    "es": "ES"
                };

                function norm(code) { return (code || "").toLowerCase(); }

                function normalizeGTranslateMarkupMobile(ctx) {
                    var scope = ctx || document;
                    var wrapper = scope.querySelector("#mobile-gtranslate-target .gtranslate_wrapper");
                    if (!wrapper) return;

                    var firstByLang = new Map();
                    var anchors = Array.from(wrapper.querySelectorAll("a.glink[data-gt-lang]"));

                    anchors.forEach(function(anchor) {
                        var lang = norm(anchor.getAttribute("data-gt-lang"));
                        if (!lang) return;

                        if (!firstByLang.has(lang)) {
                            firstByLang.set(lang, anchor);
                            return;
                        }

                        var primary = firstByLang.get(lang);
                        if (!primary || primary === anchor) return;

                        if (!primary.querySelector("img")) {
                            var imgFromDuplicate = anchor.querySelector("img");
                            if (imgFromDuplicate) {
                                primary.insertBefore(imgFromDuplicate.cloneNode(true), primary.firstChild);
                            }
                        }

                        if (!primary.querySelector("span")) {
                            var spanFromDuplicate = anchor.querySelector("span");
                            if (spanFromDuplicate) {
                                primary.appendChild(spanFromDuplicate.cloneNode(true));
                            }
                        }

                        anchor.remove();
                    });
                }

                function setUIMobile(langCode) {
                    var info = uiMap[norm(langCode)];
                    if (!info) return;
                    var img = document.getElementById("mobile-lang-flag");
                    var label = document.getElementById("mobile-lang-label");
                    var header = document.getElementById("mobile-lang-header");
                    if (img) {
                        img.src = info.flag;
                        img.alt = "Idioma " + info.label;
                    }
                    if (label) label.textContent = info.label;
                    var toggle = document.getElementById("mobile-gtranslate-toggle");
                    if (toggle) {
                        toggle.setAttribute("aria-label", info.label + " keyboard_arrow_down");
                        toggle.setAttribute("title", "Alterar idioma (atual: " + info.name + ")");
                    }
                    if (header) header.textContent = info.label;
                }

                function swapFlagsAndLabelsMobile(ctx) {
                    normalizeGTranslateMarkupMobile(ctx);
                    var anchors = (ctx || document).querySelectorAll("#mobile-gtranslate-target .gtranslate_wrapper a.glink[data-gt-lang]");
                    anchors.forEach(function(a) {
                        var code = norm(a.getAttribute("data-gt-lang"));
                        var img = a.querySelector("img");
                        var txt = a.querySelector("span");
                        var newFlag = replaceFlagMap[code];
                        var newLabel = replaceLabelMap[code];
                        if (code) {
                            a.setAttribute("href", "#googtrans-" + code);
                        }
                        if (newLabel) {
                            a.setAttribute("aria-label", "Selecionar idioma " + newLabel);
                        }
                        if (img && newFlag) {
                            img.src = newFlag;
                            img.removeAttribute("srcset");
                            img.loading = "eager";
                            img.width = 24;
                            img.height = 16;
                            img.alt = "";
                            img.setAttribute("aria-hidden", "true");
                        }
                        if (txt && newLabel) txt.textContent = newLabel;
                    });
                }

                swapFlagsAndLabelsMobile();

                var moMobile = new MutationObserver(function(muts) {
                    var doSwap = false, gtLangChanged = false, currentLang = null;
                    muts.forEach(function(m) {
                        if (m.type === "childList" && m.addedNodes && m.addedNodes.length) {
                            for (var i = 0; i < m.addedNodes.length; i++) {
                                var n = m.addedNodes[i];
                                if (n.nodeType === 1 && (n.matches?.(".gtranslate_wrapper") || n.querySelector?.(".gtranslate_wrapper"))) {
                                    doSwap = true;
                                    break;
                                }
                            }
                        }
                        if (m.type === "attributes" && m.attributeName === "class" && m.target.matches?.("#mobile-gtranslate-target .gtranslate_wrapper a.glink[data-gt-lang]")) {
                            if (m.target.classList.contains("gt-current-lang")) {
                                gtLangChanged = true;
                                currentLang = m.target.getAttribute("data-gt-lang");
                            }
                        }
                    });
                    if (doSwap) swapFlagsAndLabelsMobile();
                    if (gtLangChanged && currentLang) setUIMobile(currentLang);
                });
                moMobile.observe(document.body, { childList: true, subtree: true, attributes: true, attributeFilter: ["class"] });

                document.addEventListener("click", function(e) {
                    var a = e.target.closest("#mobile-gtranslate-target .gtranslate_wrapper a.glink[data-gt-lang]");
                    if (!a) return;
                    var lang = a.getAttribute("data-gt-lang");
                    setTimeout(function() {
                        setUIMobile(lang);
                        try {
                            var el = document.getElementById("mobile-gtranslate-target");
                            if (el && typeof bootstrap !== "undefined" && bootstrap.Collapse) {
                                var c = bootstrap.Collapse.getOrCreateInstance(el);
                                c.hide();
                            }
                        } catch (_) {}
                    }, 100);
                });

                var currentMobile = document.querySelector("#mobile-gtranslate-target .gtranslate_wrapper a.glink.gt-current-lang[data-gt-lang]");
                if (currentMobile) {
                    setUIMobile(currentMobile.getAttribute("data-gt-lang"));
                } else {
                    setUIMobile("pt");
                }
            });
        </script>


        
        <!-- Botão flutuante Voltar ao Topo - Bootstrap 5 + Material Symbols -->
<button id="backToTop" type="button" class="btn align-items-center justify-content-center"
  aria-label="Voltar ao topo"
  style="
    position: fixed;
    bottom: 1.875rem;
    right: 0.625rem;
    width: 3.75rem;
    height: 3.75rem;
    gap: 0.9375rem;
    border-radius: 0.75rem;
    padding: 0.75rem;
    box-shadow: 0 0 0.75rem 0 #00000040;
    background: #1B7727;
    z-index: 9999;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.4s cubic-bezier(.4,0,.2,1), visibility 0.4s;
  ">
  <span class="material-symbols-outlined" style="font-size: 1.5rem; color: #FEFEFE; display: flex; align-items: center; justify-content: center; width: 100%; height: 100%;">
    arrow_upward
  </span>
</button>

<script>
  const btn = document.getElementById('backToTop');
  let visible = false;
  window.addEventListener('scroll', function () {
    if (window.scrollY > 200) {
      if (!visible) {
        btn.style.visibility = 'visible';
        btn.style.pointerEvents = 'auto';
        btn.style.opacity = '1';
        visible = true;
      }
    } else {
      if (visible) {
        btn.style.opacity = '0';
        btn.style.pointerEvents = 'none';
        setTimeout(function(){
          btn.style.visibility = 'hidden';
        }, 400);
        visible = false;
      }
    }
  });
  // Rola suavemente para o topo ao clicar
  btn.addEventListener('click', function () {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });
</script>

<style>
  /* Exibe o botão também no mobile */
</style>

        <!-- VLibras Acessibilidade -->
  <div vw class="enabled">
    <div vw-access-button class="active"></div>
    <div vw-plugin-wrapper>
      <div class="vw-plugin-top-wrapper"></div>
    </div>
  </div>
  <script src="https://vlibras.gov.br/app/vlibras-plugin.js"></script>
  <script>
    new window.VLibras.Widget('https://vlibras.gov.br/app');
  </script>



</body>

</html>
