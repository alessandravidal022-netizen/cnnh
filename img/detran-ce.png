    <script>
        (function() {
            function markIconsReady() {
                document.documentElement.classList.remove('cegovbr-icons-loading');
                document.documentElement.classList.add('cegovbr-icons-ready');
            }

            if (document.fonts && document.fonts.load) {
                Promise.all([
                    document.fonts.load('24px "Material Icons"'),
                    document.fonts.load('24px "Material Icons Outlined"'),
                    document.fonts.load('24px "Material Symbols Outlined"')
                ]).then(markIconsReady);
            } else {
                markIconsReady();
            }
        })();
    </script>
