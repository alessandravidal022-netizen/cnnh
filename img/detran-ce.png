<style id="cegovbr-critical-home-css">
/* Critical CSS (home) — inlined via wp_head */

:root {
  --font-primary: 'Kanit', sans-serif;

  --color-white: #ffffff;
  --color-semiwhite: #fefefe;
  --color-gray-100: #f9f9f9;
  --color-gray-300: #c5c5c5;
  --color-gray-600: #757575;
  --color-gray-700: #465564;
  --color-black: #26323f;

  --color-primary: #007F6D;
  --color-primary-dark: #006557;
  --color-primary-25: #fafffa;
  --color-primary-50: #e9f6eb;
  --color-primary-100: #bce4c1;
  --color-primary-200: #9bd7a3;
  --color-primary-300: #6ec479;
  --color-primary-400: #51b95f;
  --color-primary-500: #26a737;
  --color-primary-600: #239832;
  --color-primary-700: #1b7727;
  --color-primary-800: #155c1e;
  --color-primary-900: #104617;

  --color-secondary: #EF6000;
  --color-leaf: #E7FFEB;

  --color-primary-hover: #009883;
  --color-primary-active: #006557;
  --color-primary-focus: #545FFF;
}

body { background-color: #F9F9F9; }

@media (min-width: 75rem) {
  .container { max-width: 67.5rem !important; }
}

.hero {
  font-family: var(--font-primary);
  font-weight: 600;
  font-size: 2.5rem;
  line-height: 1.03em;
  letter-spacing: 0;
}

.titulo {
  font-family: var(--font-primary);
  font-weight: 400;
  font-size: 1.5rem;
  line-height: 1em;
  letter-spacing: 0;
}

.subtitulo {
  font-family: var(--font-primary);
  font-weight: 300;
  font-size: 1.25rem;
  line-height: 1em;
  letter-spacing: 0;
}

.destaque {
  font-family: var(--font-primary);
  font-weight: 500;
  font-size: 1rem;
  line-height: 1em;
  letter-spacing: 0;
}

/* Header / Search */
header#main-header {
  background: linear-gradient(90deg, #007F6D 0%, #139352 74.04%, #26A737 100%);
  position: relative;
  z-index: 1001;
}

header .search-form .input-group {
  border: 0.125rem solid transparent;
  background:
    linear-gradient(#fff, #fff) padding-box,
    linear-gradient(to right, rgba(31, 166, 55, 1), rgba(90, 193, 212, 1)) border-box;
  background-clip: padding-box, border-box;
  border-radius: 2rem !important;
}

header .search-form .input-group .input-group-text:first-child {
  border-radius: 2rem 0 0 2rem !important;
}

header .search-form .input-group .input-group-text:last-child {
  border-radius: 0 2rem 2rem 0 !important;
}

header .search-form .input-group .form-control { border-radius: 0 !important; }

header .search-form .input-group .input-group-text {
  color: var(--color-gray-700) !important;
  background: transparent !important;
  border: none !important;
}

header .search-form .form-control {
  font-family: var(--font-primary);
  font-weight: 400 !important;
  font-size: 0.9375rem;
  line-height: 1em;
  box-shadow: none;
}

.cc-logo {
  width: 100%;
  max-height: 1.875rem;
  margin-top: 0.125rem;
}

@media (min-width: 75rem) {
  .cc-logo {
    height: 2.4375rem;
    max-height: 2.4375rem;
  }
}

.btn-outline-cc {
  line-height: 1em;
  font-size: 1.25rem;
  font-family: var(--font-primary);
  font-weight: 400 !important;
  color: var(--color-semiwhite);
  border: 0.0625rem solid var(--color-primary-300);
  border-radius: 0.9375rem;
  padding: 0.5rem 1rem;
  display: flex;
  align-items: center;
  gap: 0.375rem;
}

.btn-icon-cc {
  line-height: 1em;
  font-size: 1.25rem;
  font-family: var(--font-primary);
  font-weight: 400 !important;
  color: var(--color-semiwhite);
  border: 0.0625rem solid transparent;
  border-radius: 0.25rem;
  padding: 0 0.0625rem;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Main menu */
header #main-menu {
  background-color: var(--color-primary-dark);
  border-bottom-right-radius: 0.5rem;
  transition: all 0.25s ease;
  min-height: 3.1875rem; /* Evita colapso antes do menu carregar (Desktop) */
}

@media (max-width: 74.9375rem) {
  header #main-menu { min-height: 0; }
}

header #main-menu a {
  font-size: 1.25rem;
  color: var(--color-semiwhite);
  font-family: var(--font-primary);
  font-weight: 400 !important;
  line-height: 1em;
  transition: all 0.25s ease;
  border-radius: 0.5rem;
  border: 0.125rem solid transparent;
}

header #main-menu .dropdown-toggle.no-caret::after { display: none !important; }

header #main-menu .dropdown-menu {
  padding: 0;
  background-color: var(--color-semiwhite);
  border: 0.0625rem solid var(--color-gray-300);
  border-radius: 0.5rem;

  display: block;
  opacity: 0;
  transform: translateY(0.625rem);
  visibility: hidden;
  transition: opacity 0.25s ease, transform 0.25s ease;
}

header #main-menu .dropdown .dropdown-menu.show {
  opacity: 1;
  transform: translateY(0);
  visibility: visible;
}

header #main-menu .dropdown-menu li a {
  font-size: 1rem;
  font-family: var(--font-primary);
  font-weight: 500 !important;
  line-height: 1em;
  color: var(--color-gray-600);
  text-align: left;
  padding: 0.5rem 1.5rem;
  background-color: transparent !important;
  text-decoration: none;
  border-radius: 0.5rem;
}

/* Home featured banner */
.brasao-vertical {
  min-width: 3.25rem;
  border-right: 0.25rem solid var(--color-semiwhite);
}

/* Home featured services */
#cc-home-featured-services {
  min-height: 20rem; /* Evita CLS na home ao carregar serviços via JS */
}

#services-swiper { --gap: 1rem; padding: 0.25rem 0.25rem 0; }
#services-swiper .swiper-wrapper { align-items: stretch; }
#services-swiper .swiper-slide { height: auto; }

.service-card {
  outline: 0.0625rem solid var(--color-gray-300);
  border-radius: 1rem;
  text-decoration: none;
  height: 12.25rem !important;
  display: flex;
  align-items: center;
  justify-content: center;
  /* Removido !important para permitir que as classes .hfs-hidden e .loading funcionem */
  opacity: 1;
  visibility: visible;
  transform: none;
}

.service-icon {
  width: 5.5rem;
  height: 5.5rem;
  margin-bottom: 0 !important;
}

.service-title {
  font-family: var(--font-primary);
  font-size: 1rem;
  line-height: 1.3rem;
  color: var(--color-gray-700);
  font-weight: 500;
  text-align: center;
}

.ver-mais-link {
  color: #1B7727;
  text-decoration: none !important;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.ver-mais-link .destaque { text-decoration: underline !important; }
.ver-mais-link i.material-icons {
  text-decoration: none !important;
  display: inline-flex;
  align-items: center;
}

</style>
